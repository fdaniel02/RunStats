@using System.Globalization
@using System.Text
@* One small chart per metric over the same months, each against zero: the long-term average at the same pace. *@
<div class="form-charts">
    @foreach (var series in Series.Where(s => s.Months.Count > 0))
    {
        var info = FormQueries.Info(series.Metric);
        var values = series.Months.Where(m => m.Comparison is not null).Select(m => m.Comparison!.Change).ToList();
        if (values.Count == 0)
        {
            continue;
        }
        var (min, max, step) = ChartScale.Range(Math.Min(values.Min(), -info.MinChange), Math.Max(values.Max(), info.MinChange));
        var count = series.Months.Count;
        <figure class="chart">
            <figcaption>@info.Title <span class="muted">@info.ChangeUnit</span>@Note(series.Metric)</figcaption>
            <div class="area">
                <div class="grid" aria-hidden="true">
                    @foreach (var tick in ChartScale.Ticks(max - min, step).Select(t => min + t))
                    {
                        <div class="gridline @(Math.Abs(tick) < step / 1000 ? "zero" : "")" style="bottom: @Percent((tick - min) / (max - min))">
                            <span>@FormTiles.Signed(tick, TickFormat(step))</span>
                        </div>
                    }
                </div>
                <svg viewBox="0 0 @count 100" preserveAspectRatio="none" aria-hidden="true">
                    <path class="line" d="@Path(series.Months, min, max)" />
                </svg>
                <ol class="months">
                    @for (var i = 0; i < count; i++)
                    {
                        var month = series.Months[i];
                        var text = Describe(info, month);
                        <li class="slot @(i >= count / 2 ? "right" : "")" tabindex="0" aria-label="@text">
                            @if (month.Comparison is { } c)
                            {
                                <span class="dot" style="bottom: @Percent((c.Change - min) / (max - min))"></span>
                            }
                            <span class="tip" aria-hidden="true">@text</span>
                            @if (month.Month.Month % 3 == 1)
                            {
                                <span class="x" aria-hidden="true">@month.Month.ToString("MMM yy", Culture)</span>
                            }
                        </li>
                    }
                </ol>
            </div>
        </figure>
    }
</div>

@if (Series.Any(s => s.Months.Count > 0))
{
    <details class="as-table">
        <summary>Show as table</summary>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Month</th>
                        @foreach (var series in Series)
                        {
                            var info = FormQueries.Info(series.Metric);
                            <th scope="col" class="num">@info.Title (@info.ChangeUnit)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var month in Series[0].Months.Select(m => m.Month).Reverse())
                    {
                        <tr>
                            <td>@month.ToString("yyyy-MM", Culture)</td>
                            @foreach (var series in Series)
                            {
                                var comparison = series.Months.FirstOrDefault(m => m.Month == month)?.Comparison;
                                <td class="num">@(comparison is { } c ? FormTiles.Signed(c.Change, FormQueries.Info(series.Metric).Format) : Format.Missing)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

@code {
    static readonly CultureInfo Culture = CultureInfo.InvariantCulture;

    [Parameter, EditorRequired] public IReadOnlyList<FormSeries> Series { get; set; } = [];

    static RenderFragment Note(FormMetric metric) => __builder =>
    {
        if (metric == FormMetric.HeartRate)
        {
            <span class="note muted"> · lower is fitter; heat raises it</span>
        }
    };

    static string Describe(FormMetricInfo info, FormMonth month)
    {
        var name = month.Month.ToString("yyyy-MM", Culture);
        if (month.Comparison is not { } c)
            return $"{name}: not enough running at comparable paces";
        var change = FormTiles.Signed(c.Change, info.Format) + " " + info.ChangeUnit;
        if (info.ShowPercent)
            change += $", {FormTiles.Signed(c.Percent, "0.0")}%";
        return $"{name}: {info.Title.ToLowerInvariant()} {FormTiles.Value(c.Now, info)} {info.Unit} against the long-term " +
            $"{FormTiles.Value(c.Before, info)} {info.Unit} at the same pace ({change}), over {Format.Hours(c.Seconds)}";
    }

    static string TickFormat(double step)
    {
        if (step >= 1)
            return "0";
        return step >= 0.1 ? "0.0" : "0.00";
    }

    // A gap where a month has no value, instead of a line across it.
    static string Path(IReadOnlyList<FormMonth> months, double min, double max)
    {
        var path = new StringBuilder();
        var drawing = false;
        for (var i = 0; i < months.Count; i++)
        {
            if (months[i].Comparison is not { } c)
            {
                drawing = false;
                continue;
            }
            var y = 100 - (c.Change - min) / (max - min) * 100;
            path.Append(drawing ? " L" : " M").Append((i + 0.5).ToString("0.###", Culture)).Append(' ').Append(y.ToString("0.###", Culture));
            drawing = true;
        }
        return path.ToString().Trim();
    }

    static string Percent(double fraction) => (Math.Clamp(fraction, 0, 1) * 100).ToString("0.##", Culture) + "%";
}

@if (Records.Count == 0)
{
    <p class="muted">@EmptyText</p>
}
else
{
    <ul class="record-list">
        @foreach (var record in Records)
        {
            <li>
                @* Without a run (Garmin doesn't always say which one), a placeholder link without href. *@
                <a class="record-name" href="@(record.RunId is { } runId ? $"runs/{runId}" : null)" data-enhance-nav="false">@RecordTypes.Name(record.TypeId)</a>
                <span class="record-value">@RecordTypes.Value(record.TypeId, record.Value)</span>
                <span class="muted">@Format.Date(record.Date)</span>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RecordRow> Records { get; set; } = [];
    [Parameter, EditorRequired] public string EmptyText { get; set; } = "";
}

@page "/"
@using RunStats.Features.Warnings
@using RunStats.Features.Years
@inject IDashboardQueries Queries
@inject IWarningQueries WarningQueries
@inject Clock Clock

<PageTitle>Dashboard · RunStats</PageTitle>

<h1>Dashboard</h1>

@if (data is not null)
{
    <AttentionCard Warnings="warnings" />

    <section class="totals" aria-label="Totals">
        <TotalCard Label="@($"This year ({Clock.Today.Year})")" Totals="data.Year" />
        <TotalCard Label="@($"This month ({Clock.Today.ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture)})")" Totals="data.Month" />
        <TotalCard Label="@($"This week (from {Format.Date(DashboardQueries.Monday(Clock.Today))})")" Totals="data.Week" />
        @if (data.YearGoalMeters is { } goal)
        {
            <GoalCard Progress="GoalProgress.For(Clock.Today.Year, goal, data.Year.DistanceMeters, Clock.Today)" Href="@($"years/{Clock.Today.Year}")" />
        }
    </section>

    <div class="sections">
        <section class="card weeks">
            <h2>Last @data.Weeks.Count weeks</h2>
            <PeriodChart Bars="WeekBars(data.Weeks)" Id="weekly" Period="week" LabelsEveryBar="true"
                         EmptyText="@($"No runs in the last {data.Weeks.Count} weeks.")" />
        </section>

        <section class="card activity">
            <h2>Days with a run</h2>
            <ActivityCalendar Grid="grid" RunDays="data.RunDays" Today="Clock.Today" />
        </section>

        <section class="card last-runs">
            <h2>Last runs</h2>
            <RunTable Rows="data.LastRuns" />
        </section>

        <section class="card records">
            <h2>Personal records</h2>
            <RecordList Records="data.Records" EmptyText="No personal records yet." />
        </section>

        <section class="card races" id="races">
            <div class="section-head">
                <h2>Races @data.RaceYear</h2>
                @if (data.RaceYears.Count > 1)
                {
                    <YearLinks Years="data.RaceYears" Current="data.RaceYear" Href="@(year => $"?races={year}#races")" Label="Race year" />
                }
            </div>
            <RunTable Rows="data.Races" ShowName="true" EmptyText="No races yet." />
        </section>
    </div>
}

@code {
    DashboardData? data;
    IReadOnlyList<Warning> warnings = [];
    ActivityGrid grid = null!;

    [SupplyParameterFromQuery(Name = "races")] public int? RaceYear { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        grid = new ActivityGrid(Clock.Today, DashboardQueries.GridWeeks);
        data = await Queries.LoadAsync(RaceYear, CancellationToken.None);
        warnings = await WarningQueries.ActiveAsync(CancellationToken.None);
    }

    static List<ChartBar> WeekBars(IReadOnlyList<WeekTotal> weeks) =>
    [
        .. weeks.Select(w => w.IsCurrent
            ? new ChartBar($"This week (from {Format.Date(w.Monday)})", "This week", w.DistanceMeters, w.DurationSeconds, true)
            : new ChartBar($"{Format.Date(w.Monday)} – {Format.Date(w.Monday.AddDays(6))}", Format.Date(w.Monday), w.DistanceMeters, w.DurationSeconds, false))
    ];
}

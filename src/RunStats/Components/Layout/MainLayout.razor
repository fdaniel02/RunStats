@inherits LayoutComponentBase

<header class="app-header">
    <a class="brand" href="">RunStats</a>
    <nav class="app-nav">
        <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="runs">Runs</NavLink>
        @* A full page load: enhanced navigation wouldn't run the map script. *@
        <NavLink href="heatmap" data-enhance-nav="false">Heatmap</NavLink>
    </nav>
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

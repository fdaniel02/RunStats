<svg class="run-type-icon icon-@Icon.Name" viewBox="0 0 16 16" aria-hidden="true" focusable="false">@((MarkupString)Icon.Shape)</svg>

@code {
    [Parameter, EditorRequired] public string TypeKey { get; set; } = "";

    (string Name, string Shape) Icon => TypeKey switch
    {
        "treadmill_running" => ("treadmill", """<rect x="1" y="11" width="14" height="3" rx="1.5"/><path d="M11.5 11 10 3.5H13"/>"""),
        "trail_running" => ("trail", """<path d="M1 14 6 4.5 9 10 11 7 15 14Z"/>"""),
        "track_running" => ("track", """<rect x="1" y="3.5" width="14" height="9" rx="4.5"/><rect x="4.5" y="6.5" width="7" height="3" rx="1.5"/>"""),
        "indoor_running" => ("indoor", """<path d="M2 8 8 3 14 8M4 6.5V14H12V6.5"/>"""),
        "virtual_run" => ("virtual", """<rect x="2" y="3" width="12" height="8" rx="1"/><path d="M8 11V14M5.5 14H10.5"/>"""),
        "obstacle_run" => ("obstacle", """<path d="M3 14V4M13 14V4M3 6.5H13M3 9.5H13"/>"""),
        _ => ("run", """<circle cx="10.5" cy="2.5" r="1.5"/><path d="M9 5.5 7 10 9.5 12 9 15M7 10 5.5 13 2.5 13.5M9 5.5 12 8 14 7.5M9 5.5 6 6 4.5 8.5"/>""")
    };
}
